# Maintainer: Retort contributors <https://github.com/oreo1298/FreeMediaConverter>
# SPDX-License-Identifier: GPL-3.0-or-later
# Prebuilt binaries from the GitHub release (the portable tarball).
pkgname=retort-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Convert video and audio files with FFmpeg, using verified hardware acceleration (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/oreo1298/FreeMediaConverter"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'glib2' 'glibc' 'gcc-libs' 'cairo' 'pango' 'gdk-pixbuf2' 'graphene'
         'hicolor-icon-theme' 'ffmpeg')
optdepends=('intel-media-driver: Intel VA-API / Quick Sync encode'
            'vpl-gpu-rt: Intel Quick Sync runtime'
            'nvidia-utils: NVENC / NVDEC'
            'libva-utils: vainfo for System Check'
            'vulkan-tools: vulkaninfo for System Check')
provides=('retort' 'retort-cli')
conflicts=('retort' 'retort-cli')
source_x86_64=("https://github.com/oreo1298/FreeMediaConverter/releases/download/v$pkgver/retort-$pkgver-x86_64-linux.tar.xz")
source_aarch64=("https://github.com/oreo1298/FreeMediaConverter/releases/download/v$pkgver/retort-$pkgver-aarch64-linux.tar.xz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "retort-$pkgver-$CARCH-linux"
  install -Dm755 bin/retort bin/retort-cli -t "$pkgdir/usr/bin/"
  cp -a share "$pkgdir/usr/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

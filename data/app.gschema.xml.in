<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<schemalist gettext-domain="@APP_BIN@">
  <enum id="@APP_ID@.Mode">
    <value nick="simple" value="0"/>
    <value nick="advanced" value="1"/>
  </enum>
  <schema id="@APP_ID@" path="@APP_PATH@">
    <key name="window-width" type="i"><default>1040</default><summary>Window width</summary></key>
    <key name="window-height" type="i"><default>720</default><summary>Window height</summary></key>
    <key name="window-maximized" type="b"><default>false</default><summary>Window maximized</summary></key>
    <key name="mode" enum="@APP_ID@.Mode"><default>"simple"</default><summary>Simple or advanced settings</summary></key>
    <key name="preset" type="s"><default>"mp4-compatible"</default><summary>Last used preset</summary></key>
    <key name="speed" type="s"><default>"balanced"</default><summary>Speed preference (fastest, balanced, smallest)</summary></key>
    <key name="target-size-mb" type="d"><default>10.0</default><summary>Target size for the size-limit preset (MB)</summary></key>
    <key name="output-folder" type="s"><default>""</default><summary>Custom output folder (empty: next to the source)</summary></key>
    <key name="filename-template" type="s"><default>"{name}.{ext}"</default><summary>Output file name template</summary></key>
    <key name="conflict-policy" type="s"><default>"rename"</default><summary>When the output exists: rename, skip, ask or overwrite</summary></key>
    <key name="preserve-timestamps" type="b"><default>false</default><summary>Copy the source modification time to the output</summary></key>
    <key name="keep-partial" type="b"><default>false</default><summary>Keep partial output files on cancel or failure</summary></key>
    <key name="max-jobs" type="i"><range min="0" max="16"/><default>0</default><summary>Maximum parallel conversions (0: automatic)</summary></key>
    <key name="use-hardware" type="b"><default>true</default><summary>Use hardware acceleration when a test proved it works</summary></key>
    <key name="preferred-backend" type="s"><default>""</default><summary>Preferred hardware backend (empty: automatic)</summary></key>
    <key name="preferred-device" type="s"><default>""</default><summary>Only use this GPU (empty: automatic)</summary></key>
    <key name="ffmpeg-path" type="s"><default>""</default><summary>Custom ffmpeg binary (empty: automatic)</summary></key>
    <key name="notify-on-complete" type="b"><default>true</default><summary>Show a notification when conversions finish</summary></key>
    <key name="show-all-formats" type="b"><default>false</default><summary>Show exotic formats in the format picker</summary></key>
    <key name="import-extensions" type="s"><default>"mp4,m4v,mkv,mov,avi,webm,mpg,mpeg,ts,m2ts,mts,wmv,flv,3gp,ogv,mxf,vob,dv,mp3,m4a,aac,flac,wav,ogg,oga,opus,wma,aiff,aif,ape,wv,mka,ac3,eac3,dts,amr,gif,webp,apng,avif"</default><summary>File extensions picked up when a folder is added</summary></key>
    <key name="check-updates" type="b"><default>false</default><summary>Check for new versions (AppImage and tarball builds only)</summary></key>
  </schema>
</schemalist>

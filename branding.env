# Single source of truth for the application's identity.
# Read by crates/core/build.rs (Rust constants) and meson.build (data files).
# To rename the app, edit these values and run scripts/rename.sh, which also
# updates static packaging files (Flatpak manifest name, PKGBUILDs, specs...).
APP_NAME=Retort
APP_ID=io.github.oreo1298.Retort
APP_BIN=retort
APP_SUMMARY=Convert video and audio files
APP_REPO_OWNER=oreo1298
APP_REPO_NAME=FreeMediaConverter
APP_HOMEPAGE=https://github.com/oreo1298/FreeMediaConverter
